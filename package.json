{
  "name": "george-burger",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:node": "tsx watch src/server.ts",
    "build": "vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "preview": "node dist/server.js",
    "start": "node dist/server.js",
    "deploy:render": "npm run build && npm run build:node",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "db:seed": "tsx src/scripts/seed-db.ts",
    "db:migrate": "tsx src/scripts/migrate-db.ts",
    "db:console": "sqlite3 database.sqlite"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
